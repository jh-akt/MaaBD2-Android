{
  "project_id": "maa-bd2",
  "display_name": "MaaBD2 Android",
  "default_resource_id": "ADB",
  "default_task_id": "[全局]启动脚本(置顶)",
  "supported_controllers": [
    "adb"
  ],
  "attach_resource_paths": [],
  "bundled_resource_path": "project",
  "virtual_display_dpi": 240,
  "resource_package_names": {
    "ADB": "com.neowizgames.game.browndust2"
  },
  "local_overlay_path": "project_overlay",
  "github_release": {
    "owner": "sunyink",
    "repo": "MFABD2",
    "asset_pattern": "MFABD2-v[^/]+-android-arm64\\.apk",
    "bundled_version": "v4.7.0",
    "mappings": [
      {
        "archives": [
          "assets/pi.zip"
        ],
        "source": "",
        "target": ""
      },
      {
        "archives": [
          "assets/agent/bundle.zip"
        ],
        "source": "arm64-v8a/prefix/",
        "target": "python"
      },
      {
        "archives": [
          "assets/agent/bundle.zip"
        ],
        "source": "arm64-v8a/bin/",
        "target": "python/bin"
      },
      {
        "archives": [
          "assets/agent/bundle.zip"
        ],
        "source": "arm64-v8a/site-packages/",
        "target": "python/lib/python3.13/site-packages",
        "exclude": "pure\\.zip"
      },
      {
        "archives": [
          "assets/agent/bundle.zip",
          "arm64-v8a/site-packages/pure.zip"
        ],
        "source": "",
        "target": "python/lib/python3.13/site-packages"
      },
      {
        "archives": [
          "assets/agent/bundle.zip"
        ],
        "source": "arm64-v8a/agent-core.json",
        "target": "agent-core.json"
      },
      {
        "source": "lib/arm64-v8a/",
        "target": "maafw",
        "include": "(libMaa[^/]+|libc\\+\\+_shared|libonnxruntime|libopencv_world4|libfastdeploy_ppocr)\\.so"
      }
    ],
    "checks": [
      {
        "file": "agent-core.json",
        "path": [
          "abi"
        ],
        "expected": "arm64-v8a"
      },
      {
        "file": "agent-core.json",
        "path": [
          "python"
        ],
        "expected": "3.13.15"
      },
      {
        "file": "agent-core.json",
        "path": [
          "provides",
          "maafw"
        ],
        "expected": "5.14.3"
      }
    ],
    "required_paths": [
      "interface.json",
      "agent/main.py",
      "resource/base/model/ocr/rec.onnx",
      "resource/base/model/ocr/det.onnx",
      "python/bin/python3",
      "python/lib/libpython3.13.so",
      "python/lib/python3.13/site-packages/maa/agent/agent_server.py",
      "python/lib/python3.13/site-packages/numpy/_utils/__init__.py",
      "python/lib/python3.13/site-packages/numpy/_core/__init__.py",
      "maafw/libMaaFramework.so",
      "maafw/libMaaAgentClient.so",
      "maafw/libMaaAgentServer.so",
      "maafw/libMaaAndroidNativeControlUnit.so",
      "maafw/libonnxruntime.so",
      "python/lib/python3.13/site-packages/PIL/__init__.py",
      "python/lib/python3.13/site-packages/strenum/__init__.py",
      "python/lib/python3.13/site-packages/chaquopy/lib/libjpeg_chaquopy.so",
      "python/lib/python3.13/site-packages/chaquopy/lib/libfreetype.so"
    ],
    "executable_paths": [
      "python/bin/python3"
    ]
  }
}
